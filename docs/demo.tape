# mental-models demo — generated by vhs
Output docs/demo.gif

Set Shell "zsh"
Set FontSize 15
Set Width 1100
Set Height 650
Set Theme "Ayu Mirage"
Set FontFamily "JetBrains Mono"
Set Padding 24
Set Framerate 24
Set PlaybackSpeed 1

# Start in repo root
Type "cd ~/github/mental-models" Enter
Sleep 500ms

# Clear the prompt
Type "clear" Enter
Sleep 300ms

# --- Command 1: select ---
Type "uvx --from ./packages/mental_models mental-models select 'how do I decide between two jobs' -k 3"
Sleep 600ms
Enter
Sleep 12s

# Pause so viewer can read the output
Sleep 2s

# --- Command 2: apply inversion ---
Type "uvx --from ./packages/mental_models mental-models apply inversion --problem 'taking a new job'"
Sleep 600ms
Enter
Sleep 12s

# Pause for readability
Sleep 2s
